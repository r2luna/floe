{
  "name": "rookery",
  "version": "5.24.0",
  "description": "A keyboard-first desktop workspace orchestrating Claude Code across parallel git worktrees.",
  "author": "Rafael Lunardelli",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "node --test --test-reporter spec 'src/**/*.test.ts'",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:server": "node scripts/build-server.mjs && electron-vite build",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "install:local": "rm -rf /Applications/Rookery.app && cp -R dist/mac-arm64/Rookery.app /Applications/ && xattr -dr com.apple.quarantine /Applications/Rookery.app && echo 'Rookery instalado em /Applications — abra com duplo-clique.'",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.2.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.15.0",
    "mysql2": "^3.23.0",
    "node-pty": "^1.0.0",
    "pg": "^8.22.0",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "tiptap-markdown": "^0.8.10",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
