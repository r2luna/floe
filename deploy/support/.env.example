# Copied to ~/.rookery/support.env on first `rookery server support up`.
# Fill it in there (not here) and re-run.

DOMAIN=pinguim.io

# The IP the host Caddy binds (the server's Tailscale address). Rookery writes
# per-worktree route files (src/main/caddy.ts) that must bind the SAME IP as the
# main site, or Caddy fights itself over :443.
EDGE_BIND=100.72.153.33

# DB root credentials. Used by provisioning to create per-worktree databases and
# by DBGate to pre-connect to both engines. Your project's .env DB_PASSWORD must
# match these (host-native fallback connects on 127.0.0.1:3306 / :5432).
MYSQL_ROOT_PASSWORD=rookery
POSTGRES_PASSWORD=rookery

# Note: edge TLS is the HOST Caddy's job (it holds its own CF_API_TOKEN); the
# support stack no longer runs Caddy, so no Cloudflare token is needed here.
