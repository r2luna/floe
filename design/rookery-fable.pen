                      "type": "text",
                      "id": "f5XWF9",
                      "name": "② Cor só no avatar",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "② Cor só no avatar e no nome: as bolhas continuam neutras ($panel + borda suave), seguindo o padrão outline-chip do app — nada de fills saturados, e o light mode sai de graça pelos tokens.",
                      "lineHeight": 1.55,
                      "fontFamily": "$mono",
                      "fontSize": 13,
