{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "node_modules",
    "resources",
    "design/refs"
  ]
}
