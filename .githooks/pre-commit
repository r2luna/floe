#!/bin/sh
# Floe pre-commit gate: lint, typecheck, full suite at 100% coverage.
#
# It checks the working tree, not the index — what you see in `git status` is
# what gets validated. Bypass with `git commit --no-verify` when you must.
set -e

root=$(git rev-parse --show-toplevel)

# Git exports GIT_DIR/GIT_INDEX_FILE to its hooks, and every child inherits
# them. `git -C /tmp/repo ...` does NOT override GIT_DIR, so the git tests would
# run their fixture commands against THIS repository — moving the branch and
# wiping the index. Scrub the whole GIT_* surface before running anything.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
  GIT_INDEX_VERSION GIT_REFLOG_ACTION GIT_EDITOR

cd "$root"

step() {
  printf '\n\033[1m▸ %s\033[0m\n' "$1"
}

fail() {
  printf '\n\033[31m✖ pre-commit: %s failed.\033[0m Fix it, or use --no-verify.\n' "$1"
  exit 1
}

step 'lint (oxlint)'
pnpm run --silent lint || fail 'lint'

step 'typecheck (node + web)'
pnpm run --silent typecheck || fail 'typecheck'

step 'tests + 100% coverage'
pnpm run --silent test:coverage || fail 'tests/coverage'

printf '\n\033[32m✔ pre-commit: clean.\033[0m\n'
